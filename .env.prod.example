BLOG_CORS_ALLOWED_ORIGINS=https://blog.example.com
# 必填：后台接口令牌，用 `openssl rand -hex 32` 生成后填入；留空时 Compose 会拒绝启动
BLOG_ADMIN_TOKEN=
# 中转站上游（可选，留空则 /v1 代理返回 503）
RELAY_UPSTREAM_URL=
RELAY_UPSTREAM_KEY=
# 邮件通知（可选）：MAIL_ENABLED=true 且 MAIL_HOST、MAIL_FROM 非空才会启用
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
# 邮件里的链接前缀
SITE_BASE_URL=https://wynneyin.site
